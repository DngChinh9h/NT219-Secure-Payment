NODE_ENV=production
PUBLIC_APP_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1

DATABASE_URL=postgresql://<db_user>:<db_password>@<rds-endpoint>:5432/<db_name>
DB_SSL=true

CORS_ORIGINS=https://<vercel-frontend-domain>

JWT_PRIVATE_KEY_PATH=/opt/nt219/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/opt/nt219/keys/jwt_public.pem

KMS_MASTER_KEY=<64-hex-or-from-secrets-manager>
HMAC_SECRET=<hmac-secret>
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
