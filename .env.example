# Server
PORT=3000
NODE_ENV=development
PUBLIC_APP_ENV=sandbox
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Optional backward-compatible single frontend origin
FRONTEND_ORIGIN=

# Optional per-minute rate-limit overrides
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PAYMENT_MAX=60
RATE_LIMIT_REFUND_REQUEST_MAX=30
RATE_LIMIT_ADMIN_REFUND_MAX=60
# Optional reverse-proxy hop count override; production defaults to 1
TRUST_PROXY_HOPS=

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/payment_db

# JWT RS256 Keys (paths)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Crypto (TV2 generate)
HMAC_SECRET=your-hmac-secret-min-32-chars-here
KMS_MASTER_KEY=your-64-hex-chars-master-key-here

# Stripe (TV3 setup)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Manual admin seed (run: npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Operations Admin
ADMIN_ADDRESS=Admin Office
ADMIN_CCCD_NUMBER=000000000001
ADMIN_RESET_PASSWORD=false
