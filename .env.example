# Server
PORT=3000
NODE_ENV=development
PUBLIC_APP_ENV=sandbox
CORS_ORIGINS=http://localhost:5173,https://your-frontend.example
FRONTEND_ORIGIN=
TRUST_PROXY_HOPS=

# Rate limits
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PAYMENT_MAX=60
RATE_LIMIT_REFUND_REQUEST_MAX=30
RATE_LIMIT_ADMIN_REFUND_MAX=60
REQUEST_NONCE_WINDOW_MS=300000

# Risk evidence thresholds
RISK_FAILED_PAYMENT_THRESHOLD=3
RISK_REFUND_REQUEST_THRESHOLD=3
RISK_HIGH_AMOUNT_THRESHOLD=10000000

# Database
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/payment_db
DB_SSL=false
READINESS_DB_TIMEOUT_MS=3000

# JWT / Receipt ES512 ECDSA P-521 keys.
# Generate local files with: npm run keys:generate
# Do not commit generated key files.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Shared-secret MAC and envelope encryption.
# HMAC_SECRET is for message authentication codes, not digital signatures.
HMAC_SECRET=replace-with-random-minimum-32-characters
# 32 random bytes encoded as 64 hex chars or base64.
KMS_MASTER_KEY=replace-with-32-byte-hex-or-base64

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret

# Manual admin seed (run: npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Operations Admin
ADMIN_ADDRESS=Admin Office
ADMIN_CCCD_NUMBER=000000000001
ADMIN_RESET_PASSWORD=false

# Dev/test seed only (run: npm run seed)
SEED_DEV_PASSWORD=ChangeMe123!
SEED_CUSTOMER_EMAIL=customer@example.test
SEED_MERCHANT_EMAIL=merchant@example.test
