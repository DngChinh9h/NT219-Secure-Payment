# Server
PORT=3000
NODE_ENV=development
PUBLIC_APP_ENV=sandbox
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Optional backward-compatible single frontend origin
FRONTEND_ORIGIN=

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/payment_db

# JWT RS256 Keys (paths)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Crypto (TV2 generate)
HMAC_SECRET=your-hmac-secret-min-32-chars-here
KMS_MASTER_KEY=your-64-hex-chars-master-key-here

# Stripe (TV3 setup)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
