# Backend API only. Keep this file as placeholders; create the real env file outside the repository.
PORT=3000
NODE_ENV=development
PUBLIC_APP_ENV=sandbox
CORS_ORIGINS=https://your-frontend.example
TRUST_PROXY_HOPS=1

# Database and application-level MAC. HMAC is a message authentication code, not a digital signature.
DATABASE_URL=postgresql://app_user:change-me@db:5432/payment_db
DB_SSL=false
HMAC_SECRET=replace-with-random-minimum-32-characters

# Mandatory Security Service connection. Backend has no JWT/receipt private key or KMS master key.
SECURITY_SERVICE_BASE_URL=https://security-service:9443
SECURITY_CLIENT_CERT_PATH=/run/certs/backend/backend-client.crt
SECURITY_CLIENT_KEY_PATH=/run/certs/backend/backend-client.key
SECURITY_CA_CERT_PATH=/run/certs/ca/internal-ca.crt
JWT_PUBLIC_KEY_PATH=/run/public/jwt-public.pem
# SECURITY_PUBLIC_KEYS_CACHE={"jwt":{"publicKey":"...public key only..."}}

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret

# Manual admin seed only (run: npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Operations Admin
ADMIN_ADDRESS=Admin Office
ADMIN_CCCD_NUMBER=000000000001
ADMIN_RESET_PASSWORD=false

# Dev/test seed only (run: npm run seed)
SEED_DEV_PASSWORD=ChangeMe123!
SEED_CUSTOMER_EMAIL=customer@example.test
SEED_MERCHANT_EMAIL=merchant@example.test
