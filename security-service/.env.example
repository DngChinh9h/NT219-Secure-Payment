# Security Service only. Store the real file outside this repository.
SECURITY_PORT=9443
NODE_ENV=production

# HTTPS server and mTLS trust anchor
SECURITY_SERVER_CERT_PATH=/run/certs/security/security-server.crt
SECURITY_SERVER_KEY_PATH=/run/certs/security/security-server.key
SECURITY_CA_CERT_PATH=/run/certs/ca/internal-ca.crt

# This service is the sole holder of these private-key and KMS settings.
JWT_PRIVATE_KEY_PATH=/run/keys/security/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/keys/public/jwt-public.pem
RECEIPT_PRIVATE_KEY_DIR=/run/keys/security/receipt-private
RECEIPT_PUBLIC_KEY_DIR=/run/keys/security/receipt-public
KMS_MASTER_KEY=replace-with-32-byte-hex-or-base64
